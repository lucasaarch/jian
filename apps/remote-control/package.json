{
  "name": "@jian-ai/remote-control",
  "version": "0.0.0-dev",
  "description": "Jian Remote Control worker \u2014 connect a computer to a Jian gateway over HTTPS",
  "type": "module",
  "bin": {
    "jian-remote": "./dist/jian-remote.mjs"
  },
  "exports": {
    ".": "./dist/jian-remote.mjs",
    "./dist/jian-remote.mjs": "./dist/jian-remote.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "test": "node scripts/build.ts && node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@jian/contracts": "workspace:*",
    "@jian/remote-core": "workspace:*",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasaarch/jian.git",
    "directory": "apps/remote-control"
  },
  "homepage": "https://github.com/lucasaarch/jian/tree/main/apps/remote-control#readme",
  "bugs": {
    "url": "https://github.com/lucasaarch/jian/issues"
  },
  "keywords": [
    "jian",
    "remote",
    "agent",
    "gateway"
  ]
}

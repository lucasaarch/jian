{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "composite": true,
    "tsBuildInfoFile": "out/.tsbuildinfo/tsconfig.node",
    "emitDeclarationOnly": true,
    "outDir": "out/.types/node"
  },
  "include": ["electron.vite.config.ts", "src/main", "src/preload", "src/shared"]
}
